# Copy to .env.local and fill in.
# For local Cloudflare preview (`pnpm preview`) duplicate the same vars into
# .dev.vars (wrangler reads that for `wrangler dev`).

# Supabase — public client config
# For local dev, run `pnpm exec supabase start` then `pnpm exec supabase status`.
# Newer Supabase CLI renamed the keys (env-var names below stay the same):
#   - "Publishable" (sb_publishable_...) replaces the old "anon" key
#   - "Secret"      (sb_secret_...)      replaces the old "service_role" key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only admin key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this app, used by login + invite actions to construct
# OAuth/email redirect URLs. Optional locally (falls back to the request's
# Origin header). REQUIRED in production — set to your deployed URL,
# e.g. https://house-hunting-board.<account>.workers.dev
NEXT_PUBLIC_SITE_URL=

# Google OAuth — read by `supabase/config.toml` for the local Auth server.
# Create an OAuth 2.0 Web client in Google Cloud Console:
#   - Authorized JavaScript origin:    http://localhost:3000
#   - Authorized redirect URI:         http://127.0.0.1:54321/auth/v1/callback
# Restart the Supabase stack after setting these (`supabase stop && supabase start`).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# AI image edit / remix providers
GEMINI_API_KEY=
FLUX_API_KEY=
