# Copy to .env.local and fill in.
# For local Cloudflare preview (`pnpm preview`) duplicate the same vars into
# .dev.vars (wrangler reads that for `wrangler dev`).

# Supabase — public client config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only admin key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# AI image edit / remix providers
GEMINI_API_KEY=
FLUX_API_KEY=
