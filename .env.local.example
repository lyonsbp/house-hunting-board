# Copy to `.env.development.local` (NOT `.env.local`) and fill in.
# For local Cloudflare preview (`pnpm preview`) duplicate the same vars into
# .dev.vars (wrangler reads that for `wrangler dev`).
#
# ⚠️  Why .env.development.local and not .env.local?
# Next.js loads .env.local in BOTH dev and production builds (the only file
# it skips in prod is .env.development). Because the build inlines every
# `process.env.NEXT_PUBLIC_*` reference at compile time, any localhost-
# pointing values in .env.local will get baked into the production worker —
# observed symptom: deployed Google OAuth bounces you back to
# `http://localhost:3000` because the redirect URL was inlined from
# .env.local at build time. .env.development.local is only loaded in dev,
# so dev creds stay isolated to dev.

# Supabase — public client config
# For local dev, run `pnpm exec supabase start` then `pnpm exec supabase status`.
# Newer Supabase CLI renamed the keys (env-var names below stay the same):
#   - "Publishable" (sb_publishable_...) replaces the old "anon" key
#   - "Secret"      (sb_secret_...)      replaces the old "service_role" key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only admin key. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this app, used by login + invite actions to construct
# OAuth/email redirect URLs. Optional locally (falls back to the request's
# Origin header). REQUIRED in production — set to your deployed URL,
# e.g. https://house-hunting-board.<account>.workers.dev
NEXT_PUBLIC_SITE_URL=

# Google OAuth — read by `supabase/config.toml` for the local Auth server.
# Create an OAuth 2.0 Web client in Google Cloud Console:
#   - Authorized JavaScript origin:    http://localhost:3000
#   - Authorized redirect URI:         http://127.0.0.1:54321/auth/v1/callback
# Restart the Supabase stack after setting these (`supabase stop && supabase start`).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# AI image edit / remix providers
GEMINI_API_KEY=
FLUX_API_KEY=

CLOUDFLARE_API_TOKEN=

# Supabase Storage Image Transformations (resize/recompress/auto-WebP).
# Pro plan and above only — defaults OFF so the free tier doesn't 404
# on transformed URLs. Flip to "true" once the project is on Pro.
SUPABASE_IMAGE_TRANSFORMS=false

# Listing-import quota (server-only). Defaults: 10/day, no superadmins.
# In production these are also set via wrangler.jsonc `vars`.
LISTING_SCRAPE_DAILY_LIMIT=10
# Cool-down between successive refreshes of the same property. Listings
# rarely change day-to-day; this prevents Scrapfly cost from refresh spam.
LISTING_REFRESH_COOLDOWN_HOURS=12
SUPERADMIN_EMAILS=

# Scrapfly (server-only). Used as a Zillow fallback to bypass PerimeterX.
# Without it, Zillow scrapes attempt direct fetch and usually return 403.
# In production set via `wrangler secret put SCRAPFLY_API_KEY`.
SCRAPFLY_API_KEY=

# ---------------------------------------------------------------------------
# Cloudflare R2 — artifact image storage (replaces Supabase Storage)
# ---------------------------------------------------------------------------
# Backend selector for new image writes. "r2" routes paste/file/scraper/
# AI-edit-output uploads to the ARTIFACTS_R2 binding with variant resize.
# Leave unset (or "supabase") for plain `pnpm dev` — the R2 binding is only
# available under wrangler (`pnpm preview`) and in production.
STORAGE_BACKEND=

# Public base URL of the artifact bucket served via a CF custom domain
# with edge cache + immutable headers. Required when STORAGE_BACKEND=r2.
# Example: https://img.house-hunting-board.example
R2_PUBLIC_BASE=

# R2 S3-compatible credentials. Only used by `pnpm backfill-r2` (the
# one-shot migration script that copies existing Supabase Storage
# images to R2). Runtime app code uses the wrangler binding directly,
# not these keys. Create an R2 API token in the Cloudflare dashboard.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=house-hunting-board-artifacts